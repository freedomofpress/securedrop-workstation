## Configure Qubes RPC "allow" policies for SecureDrop Admin.
#
# This file is provisioned by securedrop-admin-dom0-config.
# Do not modify this file!
#
# See 31-securedrop-workstation.policy for details about numbering.

# sd-admin: copy/paste to and from sd-admin-vault
qubes.ClipboardPaste    *           sd-admin sd-admin-vault allow
qubes.ClipboardPaste    *           sd-admin-vault sd-admin allow

# sd-admin-firewall: copy/paste to and from sd-admin-vault
qubes.ClipboardPaste    *           sd-admin-firewall sd-admin-vault allow
qubes.ClipboardPaste    *           sd-admin-vault sd-admin-firewall allow
