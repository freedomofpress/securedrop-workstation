#include <tunables/global>

profile securedrop-tor-browser-firefox flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/fonts>
  #include <abstractions/nameservice>
  #include <abstractions/X>

  network unix stream,

  /var/lib/securedrop-tor-browser/active/Browser/ r,
  /var/lib/securedrop-tor-browser/active/Browser/** rixm,
  /var/lib/securedrop-tor-browser/installations/*/Browser/ r,
  /var/lib/securedrop-tor-browser/installations/*/Browser/** rixm,
  /etc/firefox/policies/policies.json r,

  owner /var/lib/securedrop-tor-browser/runtime/ rw,
  owner /var/lib/securedrop-tor-browser/runtime/** rwkl,

  deny /var/lib/securedrop-tor-browser/onion-auth/** r,
  deny owner @{HOME}/** rwklmx,
}
