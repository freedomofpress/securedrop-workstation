#include <tunables/global>

profile securedrop-tor-browser-firefox flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/fonts>
  #include <abstractions/nameservice>
  #include <abstractions/X>

  network unix stream,

  /home/user/.local/share/securedrop-tor-browser/browser/Browser/ r,
  /home/user/.local/share/securedrop-tor-browser/browser/Browser/** rixm,
  /etc/firefox/policies/policies.json r,

  owner /run/user/1000/securedrop-tor-browser/ rw,
  owner /run/user/1000/securedrop-tor-browser/** rwkl,
  deny owner /run/user/1000/securedrop-tor-browser/lifecycle.lock rwkl,
  deny owner /run/user/1000/securedrop-tor-browser/tor/{,**} rwkl,

  deny /home/user/.local/share/securedrop-tor-browser/onion-auth/** r,

  # Included abstractions grant these real-home paths. The managed browser
  # uses its runtime HOME and must not inherit access to unrelated user data.
  deny owner @{HOME}/.Private/{,**} rwklmx,
  deny owner @{HOME}/{.ICEauthority,.Xauthority,.XCompose,.drirc} rwklmx,
  deny owner @{HOME}/.local/share/sddm/.Xauthority rwklmx,
  deny owner @{HOME}/{.fonts.conf,.fonts.cache-2} rwklmx,
  deny owner @{HOME}/{.fonts,.fonts.conf.d}/{,**} rwklmx,
  deny owner @{HOME}/.local/share/fonts/{,**} rwklmx,
  deny owner @{HOME}/{.fontconfig,.cache/fontconfig}/{,**} rwklmx,
  deny owner @{HOME}/.config/fontconfig/{,**} rwklmx,
  deny owner @{HOME}/.Fontmatrix/Activated/{,**} rwklmx,
}
