#include <tunables/global>

profile securedrop-tor-browser-tor flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  network inet stream,
  network inet6 stream,
  network unix stream,

  /home/user/.local/share/securedrop-tor-browser/browser/Browser/TorBrowser/Tor/tor mr,
  /home/user/.local/share/securedrop-tor-browser/browser/Browser/TorBrowser/Tor/** rixm,
  /etc/securedrop/tor-browser/torrc r,
  /home/user/.local/share/securedrop-tor-browser/onion-auth/ r,
  /home/user/.local/share/securedrop-tor-browser/onion-auth/app-journalist.auth_private r,
  owner /run/user/1000/securedrop-tor-browser/ rw,
  owner /run/user/1000/securedrop-tor-browser/{socks.socket,control.socket,control.authcookie} rwk,
  owner /run/user/1000/securedrop-tor-browser/tor/ rw,
  owner /run/user/1000/securedrop-tor-browser/tor/** rwk,
}
